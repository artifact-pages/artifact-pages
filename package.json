{
  "name": "git-artifact-pages",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "storybook": "storybook dev -p 6006 --config-dir web/.storybook",
    "build-storybook": "storybook build --config-dir web/.storybook --output-dir web/storybook-static",
    "build": "tsc -b web/tsconfig.json && vite build --config web/vite.config.ts",
    "test:third-party-notices": "node --test scripts/generate-third-party-notices.test.mjs",
    "test:compatibility-policy": "node --test scripts/compat-gate.test.mjs scripts/release-notes.test.mjs",
    "test:vite-malformed-url": "node --test scripts/vite-malformed-url.test.mjs",
    "test:web-packaging": "node --test scripts/package-web-release.test.mjs",
    "fixtures:palette": "node scripts/benchmark-palette.mjs --generate-only",
    "benchmark:palette": "npm run build && node scripts/benchmark-palette.mjs",
    "benchmark:web-scale": "node scripts/benchmark-web-scale.mjs",
    "benchmark:cli-publish-memory": "node scripts/benchmark-cli-publish-memory.mjs",
    "benchmark:preview-discovery": "npm run build && node scripts/benchmark-preview-discovery.mjs",
    "fulltext:load": "node scripts/fulltext-load.mjs",
    "test:fulltext": "node scripts/test-fulltext-core.mjs",
    "test:text-highlight": "node --experimental-transform-types --no-warnings --test scripts/text-highlight.test.mjs",
    "test:palette-sections": "node --experimental-transform-types --no-warnings --test scripts/palette-sections.test.mjs",
    "test:reader-shell": "node --experimental-transform-types --no-warnings --test web/src/domain/*.test.mjs",
    "test:fulltext-reader": "node --experimental-transform-types --no-warnings --test web/src/data/fulltext-excerpts.test.mjs",
    "test:schema-versions": "node --experimental-transform-types --no-warnings --test web/src/data/supported-schema-versions.test.mjs",
    "test:indexes": "node --experimental-transform-types --no-warnings --test web/src/data/indexes.test.mjs",
    "test:web-unit": "npm run test:text-highlight && npm run test:palette-sections && npm run test:reader-shell && npm run test:schema-versions && npm run test:fulltext-reader && npm run test:indexes",
    "package:web": "node scripts/package-web.mjs",
    "preview": "vite preview --config web/vite.config.ts",
    "serve:local": "npm run build && docker compose up",
    "test:aws-routes": "node --test terraform/modules/aws/routes.test.js",
    "test:aws-deployment": "node --test terraform/modules/aws/routes.test.js terraform/modules/aws/deployment.test.js terraform/modules/aws/artifact-csp.test.js terraform/modules/aws/tests/aws-contract.test.js",
    "test:provider-delivery": "node --test terraform/modules/aws/routes.test.js terraform/modules/aws/deployment.test.js terraform/modules/aws/artifact-csp.test.js terraform/modules/aws/tests/aws-contract.test.js terraform/modules/aws/tests/control-keys-coverage.test.js terraform/modules/aws/tests/cli-validation-layout.test.js terraform/modules/cloudflare/modules/delivery/main.test.js terraform/modules/cloudflare/tests/*.test.js",
    "test:actions-shared": "node --test actions/shared/*.test.mjs",
    "test:action-repos": "node --test scripts/build-action-repos.test.mjs scripts/release-preflight.test.mjs",
    "test:terraform-packages": "node --test scripts/build-terraform-package-repos.test.mjs scripts/terraform-package-content.test.mjs scripts/sync-terraform-package-repos.test.mjs scripts/terraform-release-preflight.test.mjs",
    "test:cli-release": "node --test scripts/package-cli-release.test.mjs",
    "test:actions-parity": "node scripts/test-actions-parity.mjs",
    "test:app-cache-rollback": "node scripts/test-app-deploy-rollback.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:preview-retirement": "npm run build && node scripts/test-registered-flow.mjs --preview-retirement",
    "test:registered-flow": "npm run build && node scripts/test-registered-flow.mjs"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "^0.18.2"
    }
  }
}
