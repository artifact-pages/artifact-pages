{
  "name": "git-artifact-pages",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsc -b && vite build",
    "test:third-party-notices": "node --test scripts/generate-third-party-notices.test.mjs",
    "test:vite-malformed-url": "node --test scripts/vite-malformed-url.test.mjs",
    "test:web-packaging": "node --test scripts/package-web-release.test.mjs",
    "fixtures:palette": "node scripts/benchmark-palette.mjs --generate-only",
    "benchmark:palette": "npm run build && node scripts/benchmark-palette.mjs",
    "benchmark:preview-discovery": "npm run build && node scripts/benchmark-preview-discovery.mjs",
    "package:web": "node scripts/package-web.mjs",
    "preview": "vite preview",
    "serve:local": "npm run build && docker compose up",
    "test:aws-routes": "node --test infra/aws/routes.test.js",
    "test:aws-deployment": "node --test infra/aws/routes.test.js infra/aws/deployment.test.js",
    "test:provider-delivery": "node --test infra/aws/routes.test.js infra/aws/deployment.test.js infra/cloudflare/delivery/main.test.js",
    "test:app-cache-rollback": "node scripts/test-app-deploy-rollback.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:registered-flow": "npm run build && node scripts/test-registered-flow.mjs"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
