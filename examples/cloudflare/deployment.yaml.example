schemaVersion: 1
provider: cloudflare
cloudflare:
  accountId: "YOUR_CLOUDFLARE_ACCOUNT_ID"
  bucket: artifact-pages-production
  zoneId: "YOUR_CLOUDFLARE_ZONE_ID"
  publicBaseURL: https://artifacts.example.com
  # The CLI defaults to CF_R2_ACCESS_KEY_ID, CF_R2_SECRET_ACCESS_KEY, and CF_API_TOKEN.
  # Add registryReaderAccessKeyIdEnv and registryReaderSecretAccessKeyEnv only for
  # a delegated site/preview publisher with a separately scoped registry reader.
sites:
  sre:
    name: SRE & Platform
    description: Runbooks and reliability documentation.
    repository: acme/sre-docs
    sourcePath: docs/artifacts
