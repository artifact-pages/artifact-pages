# Code generated by artifact-pages registry setup (CLI v<<.CLI>>); DO NOT EDIT.
name: Artifact Pages registry

on:
  pull_request:
    paths:
      - artifact-pages.yaml
      - .github/workflows/registry.yml
      - .github/workflows/publish-site.yml
      - .github/workflows/preview-site.yml
      - .github/actions/site-sync/**
  push:
    branches: [main]
    paths:
      - artifact-pages.yaml
      - .github/workflows/registry.yml
      - .github/workflows/publish-site.yml
      - .github/workflows/preview-site.yml
      - .github/actions/site-sync/**
  workflow_dispatch:

permissions:
  contents: read
<<if eq .Provider "aws">>  id-token: write
<<end>>concurrency:
  group: artifact-pages-registry
  cancel-in-progress: false

jobs:
  sync:
    runs-on: ubuntu-24.04
    environment: ${{ github.event_name != 'pull_request' && 'production' || '' }}
<<if eq .Provider "cloudflare">>    env:
<<range .CloudflareEnv>>      <<.>>: ${{ secrets.<<.>> }}
<<end>><<end>>    steps:
<<if eq .Provider "aws">>      - name: Configure AWS credentials through GitHub OIDC
        uses: aws-actions/configure-aws-credentials@<<.AWSCredsSHA>> # <<.AWSCredsVersion>>
        with:
          role-to-assume: ${{ vars.ARTIFACT_PAGES_REGISTRY_ADMIN_ROLE_ARN }}
          aws-region: <<.AWSRegion>>
          role-session-name: artifact-pages-registry
<<end>>      - name: Reconcile the configured site registry
        uses: artifact-pages/registry-action@<<.RegistrySHA>> # <<.RegistryVersion>>
        with:
          config: artifact-pages.yaml
          publish-on: |
            push:refs/heads/main
            workflow_dispatch:refs/heads/main
