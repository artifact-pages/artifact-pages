name: Artifact Pages site workflow
description: Use the admin repository's bundled config to publish one registered site or its pull-request preview.
author: artifact-pages
inputs:
  site:
    description: Registered Artifact Pages site ID.
    required: true
  mode:
    description: Operation selected by the admin reusable workflow (publish or preview).
    required: true
runs:
  using: composite
  steps:
<<if eq .Provider "aws">>    - name: Select the registered site's AWS role
      id: role
      shell: bash
      env:
        ARTIFACT_PAGES_SITE: ${{ inputs.site }}
      run: |
        set -euo pipefail
        if [[ ! "$ARTIFACT_PAGES_SITE" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
          echo "site must be a valid registered site ID" >&2
          exit 2
        fi
        role_arn="$(jq -er --arg site "$ARTIFACT_PAGES_SITE" '.[$site] | select(type == "string")' "$GITHUB_ACTION_PATH/aws-roles.json")" || {
          echo "no AWS role is registered for site '$ARTIFACT_PAGES_SITE'" >&2
          exit 2
        }
        if [[ ! "$role_arn" =~ ^arn:(aws|aws-us-gov|aws-cn):iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$ ]]; then
          echo "the AWS role registered for this site is not a valid IAM role ARN" >&2
          exit 2
        fi
        printf 'role-arn=%s\n' "$role_arn" >> "$GITHUB_OUTPUT"
    - name: Configure AWS credentials through GitHub OIDC
      uses: aws-actions/configure-aws-credentials@<<.AWSCredsSHA>> # <<.AWSCredsVersion>>
      with:
        role-to-assume: ${{ steps.role.outputs['role-arn'] }}
        aws-region: <<.AWSRegion>>
        role-session-name: artifact-pages-site
<<end>>    - name: Publish the registered site
      if: ${{ inputs.mode == 'publish' }}
      uses: artifact-pages/publish-action@<<.PublishSHA>> # <<.PublishVersion>>
      with:
        site: ${{ inputs.site }}
        config: ${{ github.action_path }}/../../../artifact-pages.yaml
        publish-on: |
          push:refs/heads/main
          workflow_dispatch:refs/heads/main
    - name: Publish the registered site's preview
      if: ${{ inputs.mode == 'preview' }}
      uses: artifact-pages/preview-action@<<.PreviewSHA>> # <<.PreviewVersion>>
      with:
        site: ${{ inputs.site }}
        config: ${{ github.action_path }}/../../../artifact-pages.yaml
        comment: 'true'
<<if eq .Provider "aws">># aws-roles.json sha256: <<.RolesHash>>
<<end>>
