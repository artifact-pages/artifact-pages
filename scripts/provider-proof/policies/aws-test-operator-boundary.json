{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyS3OutsideTheProofBucket",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": ["{{PROOF_BUCKET_ARN}}", "{{PROOF_BUCKET_ARN}}/*"]
    },
    {
      "Sid": "DenyPreservedProductionBucket",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::artifact-pages-231136241959-us-east-1",
        "arn:aws:s3:::artifact-pages-231136241959-us-east-1/*"
      ]
    },
    {
      "Sid": "DenyCloudFrontOutsideTheProofDistribution",
      "Effect": "Deny",
      "Action": "cloudfront:*",
      "NotResource": "{{PROOF_DISTRIBUTION_ARN}}"
    },
    {
      "Sid": "DenyPreservedProductionDistribution",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "arn:aws:cloudfront::231136241959:distribution/ECFTIR5GVPQDF"
    },
    {
      "Sid": "DenyPrivilegeEscalationAndRoleChaining",
      "Effect": "Deny",
      "Action": ["iam:*", "sts:AssumeRole", "sts:TagSession", "sts:SetSourceIdentity"],
      "Resource": "*"
    },
    {
      "Sid": "MaximumProofBucketAuthority",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectVersion",
        "s3:GetObjectVersionTagging",
        "s3:DeleteObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:GetBucketLifecycleConfiguration",
        "s3:GetBucketVersioning"
      ],
      "Resource": ["{{PROOF_BUCKET_ARN}}", "{{PROOF_BUCKET_ARN}}/*"]
    },
    {
      "Sid": "MaximumProofDistributionAuthority",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation", "cloudfront:GetDistribution", "cloudfront:GetDistributionConfig"],
      "Resource": "{{PROOF_DISTRIBUTION_ARN}}"
    },
    {
      "Sid": "ReadCallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
