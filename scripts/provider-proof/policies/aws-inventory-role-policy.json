{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEveryActionOutsideTheReadInventorySet",
      "Effect": "Deny",
      "NotAction": [
        "sts:GetCallerIdentity",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketLifecycleConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketTagging",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketCORS",
        "s3:GetBucketWebsite",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketLogging",
        "s3:GetBucketReplication",
        "s3:GetBucketObjectLockConfiguration",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectTagging",
        "s3:GetObjectVersionTagging",
        "s3:GetObjectAttributes",
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:ListTagsForResource",
        "iam:GetOpenIDConnectProvider",
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetRolePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadIdentityAndEnumerateBucketNames",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity", "s3:ListAllMyBuckets"],
      "Resource": "*"
    },
    {
      "Sid": "ReadEnumeratedBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketLifecycleConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketTagging",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketCORS",
        "s3:GetBucketWebsite",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketLogging",
        "s3:GetBucketReplication",
        "s3:GetBucketObjectLockConfiguration"
      ],
      "Resource": ["{{PRESERVED_BUCKET_ARN}}", "{{PROOF_BUCKET_ARN}}"]
    },
    {
      "Sid": "ReadEnumeratedBucketObjectsAndVersions",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": ["{{PRESERVED_BUCKET_ARN}}", "{{PROOF_BUCKET_ARN}}"]
    },
    {
      "Sid": "ReadEnumeratedObjectMetadataAndTags",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectTagging",
        "s3:GetObjectVersionTagging",
        "s3:GetObjectAttributes"
      ],
      "Resource": ["{{PRESERVED_BUCKET_ARN}}/*", "{{PROOF_BUCKET_ARN}}/*"]
    },
    {
      "Sid": "ReadPreservedAndBoundProofDistributions",
      "Effect": "Allow",
      "Action": ["cloudfront:GetDistribution", "cloudfront:GetDistributionConfig", "cloudfront:ListTagsForResource"],
      "Resource": ["{{PRESERVED_DISTRIBUTION_ARN}}", "{{PROOF_DISTRIBUTION_ARN}}"]
    },
    {
      "Sid": "ReadExistingGithubOidcProvider",
      "Effect": "Allow",
      "Action": "iam:GetOpenIDConnectProvider",
      "Resource": "arn:aws:iam::231136241959:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "ReadExactProofRolesAndPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetRolePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": ["{{PROOF_ROLE_ARNS}}", "{{PROOF_POLICY_ARNS}}"]
    },
    {
      "Sid": "ReadOnlyInventoriedTerraformStateObject",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "{{INVENTORY_STATE_OBJECT_ARN}}"
    },
    {
      "Sid": "DenyAllOtherBuckets",
      "Effect": "Deny",
      "Action": [
        "s3:GetBucketLocation", "s3:GetBucketVersioning", "s3:GetBucketLifecycleConfiguration",
        "s3:GetBucketPublicAccessBlock", "s3:GetBucketOwnershipControls", "s3:GetEncryptionConfiguration",
        "s3:GetBucketTagging", "s3:GetBucketPolicy", "s3:GetBucketPolicyStatus", "s3:GetBucketCORS",
        "s3:GetBucketWebsite", "s3:GetAccelerateConfiguration", "s3:GetBucketRequestPayment",
        "s3:GetBucketLogging", "s3:GetBucketReplication", "s3:GetBucketObjectLockConfiguration",
        "s3:ListBucket", "s3:ListBucketVersions", "s3:GetObject", "s3:GetObjectVersion",
        "s3:GetObjectTagging", "s3:GetObjectVersionTagging", "s3:GetObjectAttributes"
      ],
      "NotResource": ["{{PRESERVED_BUCKET_ARN}}", "{{PRESERVED_BUCKET_ARN}}/*", "{{PROOF_BUCKET_ARN}}", "{{PROOF_BUCKET_ARN}}/*", "{{INVENTORY_STATE_OBJECT_ARN}}"]
    },
    {
      "Sid": "DenyAllOtherDistributions",
      "Effect": "Deny",
      "Action": "cloudfront:*",
      "NotResource": ["{{PRESERVED_DISTRIBUTION_ARN}}", "{{PROOF_DISTRIBUTION_ARN}}"]
    }
  ]
}
