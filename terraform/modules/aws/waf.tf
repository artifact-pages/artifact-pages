  region             = "us-east-1"
  name               = "${var.name_prefix}-allowlist-${lower(each.key)}"
  scope              = "CLOUDFRONT"
  ip_address_version = each.key
  addresses          = local.waf_has_allowlist ? local.waf_family_cidrs[each.key] : []
  tags               = var.tags
}

