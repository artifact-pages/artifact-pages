                          custom_response_body_key = try(response.value.custom_response_body_key, null)
                          dynamic "response_header" {
                            for_each = { for index, item in lookup(response.value, "response_header", null)[*] : tostring(index) => item }
                            iterator = header
                            content {
                              name  = try(header.value.name, null)
                              value = try(header.value.value, null)
                            }
                          }
                        }
                      }
                    }
                  }
                  dynamic "count" {
                    for_each = contains(keys(override.value.action_to_use), "count") ? (override.value.action_to_use.count == null ? [] : [override.value.action_to_use.count]) : []
                    iterator = act_count
                    content {
                    }
                  }
                }
              }
            }
          }
        }
      }
      visibility_config {
        cloudwatch_metrics_enabled = coalesce(try(free_rule.value.visibility_config.cloudwatch_metrics_enabled, null), true)
        sampled_requests_enabled   = coalesce(try(free_rule.value.visibility_config.sampled_requests_enabled, null), false)
        metric_name                = coalesce(try(free_rule.value.visibility_config.metric_name, null), "${var.name_prefix}-r-${substr(sha256(free_rule.value.name), 0, 20)}")
      }
    }
  }
}
